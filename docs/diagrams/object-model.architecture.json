  "cards": [
    { "dot": "emerald", "title": "三层分离", "items": ["事实（Event）、证据（Case）、模式（Claim）三层不混", "单次实验 ≠ 通用规律，多 Case 聚合才升级 Claim"] },
    { "dot": "cyan", "title": "检索 vs 追溯", "items": ["检索/推荐用 Claim（跨单据通用）", "追溯用 Case（回到具体 run）", "回灌用 Event（追加事实）"] },
    { "dot": "amber", "title": "检索键", "items": ["能力标签与字段名解耦", "字段语义概念是 L3 字段层匹配锚"] }
