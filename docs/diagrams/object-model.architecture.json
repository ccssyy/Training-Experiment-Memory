    { "id": "tags", "type": "cloud", "label": "通用能力标签", "sublabel": "语义·值形态·基数·版式", "pos": [540, 100], "size": [190, 56], "tag": "检索键" },
    { "id": "concepts", "type": "cloud", "label": "字段语义概念", "sublabel": "85 概念 · 别名 + 值形态", "pos": [290, 100], "size": [190, 56], "tag": "匹配锚" },

    { "id": "store", "type": "database", "label": "memory.db", "sublabel": "独立存储", "pos": [800, 260], "size": [130, 64] }
  ],
  "boundaries": [
    { "kind": "region", "label": "记忆数据（memory/）", "wraps": ["event", "case", "claim", "tags", "concepts"] }
  ],
  "connections": [
    { "from": "event", "to": "case", "label": "关联/创建", "variant": "default" },
