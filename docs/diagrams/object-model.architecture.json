    { "from": "claim", "to": "tags", "label": "标注", "variant": "dashed", "fromSide": "top", "toSide": "bottom" },
    { "from": "concepts", "to": "tags", "label": "概念→标签", "variant": "dashed" },
    { "from": "claim", "to": "store", "label": "落库", "variant": "emphasis", "fromSide": "right", "toSide": "left" }
